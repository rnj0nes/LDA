TITLE:    MLFA CESD EPESE
DATA:     FILE = cesd.dat ;
VARIABLE: NAMES = id t female agec70 y1 y2 y3 y4 y5 y6 ; 
          MISSING = . ;
          WITHIN = t ;
          BETWEEN = agec70 female ; 
          CLUSTER = id ;
ANALYSIS: TYPE = TWOLEVEL RANDOM ;
MODEL:    %WITHIN%
            fw BY y1@0.51150 (l1);
            fw by y2-y6* (l2-l6);
            s | fw on t ; 
          %BETWEEN%
            fb BY y1@0.51150 (l1);
            fb by y2-y6* (l2-l6);
            y1-y6@0;
            fb on agec70 female ;
            s on agec70 female ;
            fb with s ;
            [y1@1.35775]; 
            [fb*];

