TITLE:    MLFA Preliminary Model 2
DATA:     FILE = cesd.dat ;
VARIABLE: NAMES = id t female agec70 y1 y2 y3 y4 y5 y6 ; 
          USEVARIABLES = female agec70 y1-y6 ;
          USEOBSERVATIONS = (t==0) ;
          MISSING = . ;
OUTPUT:   STDYX ; TECH4 ; SVALUES;
MODEL:    fw by y1-y6* (l1-l6);
          fw@0.976; !1-R-squared
          fw on female agec70 ;
